# ===== Turso (https://app.turso.tech) =====
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ===== 鉴权 =====
# JWT 签名密钥：至少 32 字节随机串（openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-secret
# 管理台令牌（/admin/*，独立于用户体系）
ADMIN_TOKEN=change-me-admin-token

# ===== 搜索中继 =====
# duckduckgo（默认，免 Key）| serper | bocha
SEARCH_PROVIDER=duckduckgo
SERPER_API_KEY=
BOCHA_API_KEY=

# ===== 云端定时任务的 LLM（OpenAI 兼容）=====
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=

# ===== 站点对外地址 =====
# App 端拼「云端模型」请求地址时用。若留空, 后端会尝试从请求头 Origin/Referer 推断,
# 但 App 的跨域请求可能不带 Origin, 建议显式配置。
PUBLIC_BASE_URL=https://your-domain.example.com

# ===== AI 模型供应商（管理台配置, 通常无需改环境变量）=====
# 上游 Key 在管理台「供应商配置」里录入, 用 JWT_SECRET 派生密钥加密后存库。
# ⚠️ 更换 JWT_SECRET 会导致已录入的上游 Key 无法解密, 需要重新录入。
# 周额度(每轮对话计 1 点, 每周一 00:00 UTC+8 自动归零)定义在 src/plans.ts 的 WEEKLY_LIMITS:
#   免费版 100 / 专业版 1000 / 永久版 20000

# ===== 更新分发 =====
UPDATE_LATEST_VERSION=0.2.35
UPDATE_MIN_VERSION=0.2.0
# 本次更新是否强制（true=强更 / false=普通更新；低于 MIN_VERSION 一律强更）
UPDATE_FORCE_UPDATE=false
UPDATE_NOTES=请阅读 RELEASE_NOTES.md
UPDATE_APK_URL=https://example.com/orion-agent.apk

# ===== 套餐限额覆盖（可选，格式 JSON）=====
# PLAN_LIMITS_OVERRIDE={"free":{"relay_search":30}}

# ===== 注册邮箱域名白名单（可选）=====
# 逗号分隔，可带 @。留空用默认：qq.com,189.cn,139.com,163.com,126.com
# 不在名单内的邮箱注册时会收到「邮箱不支持」并被拒绝。
# REGISTER_EMAIL_DOMAINS=qq.com,189.cn,139.com,163.com,126.com

# 排障用: true 时 500 响应附带原始错误与堆栈(默认关闭)
DEBUG_ERRORS=false
